# ============================================
# FastAPI Base Scaffold 配置文件
# ============================================

# ============================================
# 应用配置 (App Config)
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_CORS_ORIGINS=*
APP_ENABLE_GZIP=true
AUDIT_LOG_RETENTION_DAYS=180
# 平台展示名（邮件主题/落款等会读取它，便于多实例换品牌名）
APP_NAME=智慧AI 探索平台

# ============================================
# 数据库配置 (Database Config)
# ============================================
# 默认连接 MySQL；设置 APP_USE_SQLITE=true 可切换为 SQLite（本地轻量开发）
# APP_USE_SQLITE=true
DB_USER=root
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fastapi_scaffold

# ============================================
# Redis 配置 (Redis Config)
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT 配置 (JWT Config)
# ============================================
# 生产环境请修改为强随机字符串
JWT_SECRET_KEY=your_jwt_secret_key_here_please_change
JWT_EXPIRE_MINUTES=480

# ============================================
# SMTP 邮件 (SMTP Mail)
# ============================================
# 用于"找回密码"等需要发邮件的功能。
# 全部留空 / SMTP_HOST 为空 → 视为"未配置"：相关接口返回 503 + "邮件服务暂未开通"友好提示，不阻断启动。
# SMTP_PORT 常用：25（明文，不推荐）/ 587（STARTTLS）/ 465（SSL）
# 端口 465 时请同时 SMTP_USE_SSL=true，端口 587 时 SMTP_USE_TLS=true。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人地址，支持 "显示名 <addr@example.com>" 格式
SMTP_SENDER=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ============================================
# 七牛云存储 (Qiniu Cloud Storage)
# ============================================
# 用于 Agent 头像 / 媒体（webm/mov/apng）/ 语音文件上传。
# 旧 Java 项目 (QiniuUtil.java) 硬编码同套凭据，迁移时复用相同 bucket 与域名。
# 区域：华南 z2；SDK：7.13.1
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET=platform
QINIU_UPLOAD_ENDPOINT=https://up-z2.qiniup.com
QINIU_PUBLIC_DOMAIN=https://qiniu.muqiangyun.cn
QINIU_TOKEN_EXPIRE=3600

# ============================================
# 种子管理员 (Seed Admin)
# ============================================
# 首次部署用，仅当数据库里完全没有该 email/username 时才会创建。
# SEED_ADMIN_PASSWORD 留空 → 跳过创建（推荐生产环境用），需要时通过运维通道手工建号。
# 已创建后，请首次登录立即改密；该账号 fixed=true，不可被删除 / 降级。
SEED_ADMIN_EMAIL=admin@local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
