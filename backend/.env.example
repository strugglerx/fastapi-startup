# ============================================
# FastAPI Base Scaffold 配置文件
# ============================================

# ============================================
# 应用配置 (App Config)
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_CORS_ORIGINS=*
APP_ENABLE_GZIP=true
AUDIT_LOG_RETENTION_DAYS=180

# ============================================
# 数据库配置 (Database Config)
# ============================================
# 默认连接 MySQL；设置 APP_USE_SQLITE=true 可切换为 SQLite（本地轻量开发）
# APP_USE_SQLITE=true
DB_USER=root
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fastapi_scaffold

# ============================================
# Redis 配置 (Redis Config)
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT 配置 (JWT Config)
# ============================================
# 生产环境请修改为强随机字符串
JWT_SECRET_KEY=your_jwt_secret_key_here_please_change
JWT_EXPIRE_MINUTES=480

# ============================================
# 七牛云存储 (Qiniu Cloud Storage)
# ============================================
# 用于 Agent 头像 / 媒体（webm/mov/apng）/ 语音文件上传。
# 旧 Java 项目 (QiniuUtil.java) 硬编码同套凭据，迁移时复用相同 bucket 与域名。
# 区域：华南 z2；SDK：7.13.1
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET=platform
QINIU_UPLOAD_ENDPOINT=https://up-z2.qiniup.com
QINIU_PUBLIC_DOMAIN=https://qiniu.muqiangyun.cn
QINIU_TOKEN_EXPIRE=3600
